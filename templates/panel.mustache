{{!
    @template tiny_muai/panel

    Floating panel rendered by the tiny_muai editor plugin to display an AI
    review response alongside (and independent of) the TinyMCE editor.

    The shell is rendered via this template; the body (data-region="muai-body")
    is populated imperatively by commands.js with either a loading spinner
    or the response text. Styling lives in tiny_muai/styles.css.

    Context variables required for this template:
    * title - localised panel title
    * refreshtitle - localised refresh button tooltip / aria-label
    * closetitle - localised close button tooltip / aria-label
    * checkrevised - localised label for the "Check revised" button
    * checkrevisedtitle - localised tooltip / aria-label for "Check revised"
    * historyheading - localised heading shown above the history items
    * historyshow - localised label for the (initially-disabled) show-history toggle
    * historytitle - localised tooltip / aria-label for the show-history toggle

    Example context (json):
    {
        "title": "Review",
        "refreshtitle": "Refresh with current editor content",
        "closetitle": "Close",
        "checkrevised": "Check revised",
        "checkrevisedtitle": "Check the revised text against the original review",
        "historyheading": "History",
        "historyshow": "Show history",
        "historytitle": "Show previous responses"
    }
}}
<div class="tiny-muai-panel" role="dialog" aria-label="{{title}}" data-region="muai-panel">
    <div class="tiny-muai-panel-header" data-region="muai-drag-handle">
        <span class="tiny-muai-panel-title">{{title}}</span>
        <button type="button" class="tiny-muai-panel-btn" data-action="muai-refresh" title="{{refreshtitle}}" aria-label="{{refreshtitle}}">&#x21bb;</button>
        <button type="button" class="tiny-muai-panel-btn" data-action="muai-close" title="{{closetitle}}" aria-label="{{closetitle}}">&#x00d7;</button>
    </div>
    <div class="tiny-muai-panel-body" data-region="muai-body"></div>
    <div class="tiny-muai-panel-history" data-region="muai-history" hidden>
        <div class="tiny-muai-panel-history-header">{{historyheading}}</div>
        <div class="tiny-muai-panel-history-items" data-region="muai-history-items"></div>
    </div>
    <div class="tiny-muai-panel-footer" data-region="muai-footer">
        <button type="button" class="tiny-muai-panel-history-btn" data-action="muai-history-toggle" title="{{historytitle}}" aria-label="{{historytitle}}" aria-expanded="false" disabled>{{historyshow}}</button>
        <button type="button" class="tiny-muai-panel-checkrevised-btn" data-action="muai-checkrevised" title="{{checkrevisedtitle}}" aria-label="{{checkrevisedtitle}}" disabled>{{checkrevised}}</button>
    </div>
</div>
